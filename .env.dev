# Archivo de entorno de desarrollo: .env.dev
# ----------------------------
# URL base de la API de CryptoMesh
VITE_CRYPTOMESH_URL=http://cryptomesh:19000
VITE_CRYPTOMESH_API_VERSION=v1

# URL base de la API de ShieldX (Choreography)
VITE_SHIELDX_URL=http://shieldx:20000
VITE_API_VERSION=v1

# URL base de la API de Axo_backend
VITE_AXO_BACKEND_URL=http://axo-backend:17000

MONGODB_URI="mongodb://axo-db:27017/axodb"
MONGO_DATABASE_NAME="axodb"

# ----------------------------
# CryptoMesh settings
# ----------------------------
CRYPTOMESH_HOST=0.0.0.0
CRYPTOMESH_PORT=19000
CRYPTOMESH_MAX_CPU=4
CRYPTOMESH_MAX_RAM=8
CRYPTOMESH_DEBUG=1
CRYPTOMESH_VERSION=0.0.1a0
CRYPTOMESH_API_PREFIX=/api/v1
CRYPTOMESH_TITLE=CryptoMesh API

CRYPTOMESH_MONGO_PORT=27017
CRYPTOMESH_MONGO_DATABASE_NAME=cryptomesh
CRYPTOMESH_MONGODB_URI=mongodb://axo-db:27017/cryptomesh

CRYPTOMESH_LOG_PATH=./logs
CRYPTOMESH_LOG_LEVEL=DEBUG
CRYPTOMESH_LOG_ROTATION_WHEN=m
CRYPTOMESH_LOG_ROTATION_INTERVAL=10
CRYPTOMESH_LOG_TO_FILE=1
CRYPTOMESH_LOG_ERROR_FILE=0

CRYPTOMESH_SUMMONER_IP_ADDR=mictlanx-summoner-0
CRYPTOMESH_MICTLANX_LOG_PATH=/app/logs
CRYPTOMESH_MICTLANX_URI=mictlanx://mictlanx-router-0@mictlanx-router-0:60666?/api_version=4&protocol=http

AXO_LOG_PATH=/app/logs
SHIELDX_LOG_PATH=/app/logs
LOG_PATH=/app/logs

# ----------------------------
# Shieldx settings
# ----------------------------
SHIELDX_MONGODB_URI=mongodb://axo-db:27017/shieldx
SHIELDX_MONGO_DATABASE=shieldx
SIELDX_PORT=20000
SHIELDX_LOG_PATH=/app/log
LOG_LEVEL=DEBUG
LOG_ROTATION_WHEN=h
LOG_ROTATION_INTERVAL=24
SHIELDX_ENV=prod