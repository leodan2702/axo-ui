# URL base de la API de CryptoMesh
# VITE_CRYPTOMESH_URL=http://cryptomesh-server:19000
# VITE_CRYPTOMESH_API_VERSION=v1

# URL base de la API de ShieldX (Choreography)
# VITE_SHIELDX_URL=http://shieldx-server:20000
# VITE_API_VERSION=v1

# URL base de la API de Axo_backend
# VITE_AXO_BACKEND_URL=http://axo-backend:17000

MONGODB_URI="mongodb://localhost:27017/axodb"
MONGO_DATABASE_NAME="axodb"

# URL base de la API de CryptoMesh
VITE_CRYPTOMESH_URL=http://localhost:19000
VITE_CRYPTOMESH_API_VERSION=v1
VITE_FETCH_CREDENTIALS=same-origin
VITE_BASE_PATH=/
VITE_SERVER_PORT=5173
VITE_MICTLANX_BASE_URL=http://localhost:60666
# URL base de la API de ShieldX (Choreography)
VITE_SHIELDX_URL=http://localhost:20000
VITE_API_VERSION=v1

# URL base de la API de Axo_backend
VITE_AXO_BACKEND_URL=http://localhost:17000
